<UserControl x:Class="Isle.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Isle.Helpers">
    <DockPanel>
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Flat}" Width="40" Click="OnNew" ToolTip="Новый разговор">
                <h:Icon Kind="Note" Width="15" Height="15"/>
            </Button>
            <TextBox x:Name="Input" Grid.Column="1" Margin="8,0" Tag="Сообщение для ИИ…" AcceptsReturn="True" TextWrapping="Wrap"
                     MaxHeight="90" VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnKey"/>
            <Button x:Name="SendBtn" Grid.Column="2" Style="{StaticResource Primary}" Width="40" Click="OnSend" ToolTip="Отправить (Enter)">
                <h:Icon Kind="Send" Width="15" Height="15" Foreground="#08080A"/>
            </Button>
        </Grid>
        <Grid>
            <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="10" Height="20" CornerRadius="5" Background="{StaticResource Fg}"/>
                    <Border Width="10" Height="20" CornerRadius="5" Background="{StaticResource Fg}" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="Спроси что угодно" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                <TextBlock x:Name="ModelLine" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                <StackPanel x:Name="Suggestions" Margin="0,14,0,0"/>
            </StackPanel>
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="Messages">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="bubble" CornerRadius="14" Padding="12,9" Margin="0,0,0,8" MaxWidth="680"
                                    HorizontalAlignment="Left" Background="{StaticResource Card}">
                                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent"
                                         BorderThickness="0" Padding="0" FontSize="13">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="bubble" Property="Background" Value="#1F1F24"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
