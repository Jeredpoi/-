<UserControl x:Class="Isle.Views.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Isle.Helpers"
             xmlns:v="clr-namespace:Isle.Views">
    <UserControl.Resources>
        <v:DayTitleConverter x:Key="DayTitle"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource Pane}" BorderBrush="{DynamicResource PaneBorder}" BorderThickness="1" CornerRadius="16" Padding="{DynamicResource PanePad}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- папки: вся история, закреплённые и свои -->
        <DockPanel Margin="0,0,14,0">
            <TextBlock DockPanel.Dock="Top" Text="ПАПКИ" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" Margin="10,2,0,8"/>
            <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button x:Name="NewFolderBtn" Style="{StaticResource Ghost}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnNewFolder" Padding="10,7">
                    <StackPanel Orientation="Horizontal">
                        <h:Icon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Text="Новая папка" FontSize="12" Foreground="{DynamicResource Muted}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <TextBox x:Name="FolderName" Visibility="Collapsed" Height="32" Padding="10,0" VerticalContentAlignment="Center" FontSize="12"
                         Tag="Название и Enter" KeyDown="OnFolderNameKey" LostKeyboardFocus="OnFolderNameLost"/>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FoldersPanel"/>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Search" Tag="Поиск по истории" Height="34" Padding="34,0,10,0" VerticalContentAlignment="Center"
                         TextChanged="OnSearch" PreviewKeyDown="OnSearchKey"/>
                <h:Icon Kind="Search" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"/>
                <!-- «Очистить» спрятана в меню: случайно не нажмёшь, и есть «Отменить» -->
                <Button x:Name="MoreBtn" Grid.Column="1" Style="{StaticResource Ghost}" Margin="6,0,0,0" Width="34" Height="34" Click="OnMore" ToolTip="Ещё">
                    <h:Icon Kind="More" Width="16" Height="16" StrokeWidth="2.6"/>
                </Button>
            </Grid>

            <!-- фильтр по типу: показываются только типы, которые есть в текущей папке -->
            <StackPanel x:Name="TypesPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"/>

            <!-- куда сейчас сохраняются копии -->
            <Border x:Name="RecordBar" DockPanel.Dock="Top" Background="#14141A" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="8,2" Click="OnStopRecord" ToolTip="Перестать сохранять в папку">
                        <TextBlock Text="Выключить" FontSize="11"/>
                    </Button>
                    <Ellipse x:Name="RecordDot" Width="8" Height="8" Fill="#FF5A5F" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RecordText" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- у папки есть приложения: их снимки попадают сюда сами -->
            <Border x:Name="AppsBar" DockPanel.Dock="Top" Background="#121216" BorderBrush="#24242B" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="8,2" Click="OnEditApps">
                        <TextBlock Text="Изменить" FontSize="11"/>
                    </Button>
                    <h:Icon Kind="Crop" Width="13" Height="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AppsText" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <Grid DockPanel.Dock="Bottom" Margin="2,8,0,0">
                <TextBlock x:Name="Hint" Style="{StaticResource MutedText}" FontSize="11"
                           Text="Клик — вставить · Shift+клик — только скопировать · перетащи запись в папку слева или в другую программу"/>
                <Border x:Name="UndoBar" Background="#1A1A1F" CornerRadius="10" Padding="12,5" Visibility="Collapsed" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UndoText" FontSize="12" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource Ghost}" Margin="10,0,0,0" Padding="8,2" Click="OnUndo">
                            <TextBlock Text="Отменить" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                    <Button x:Name="EmptyBtn" Style="{StaticResource Flat}" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="14,7" Click="OnEmptyAction" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyBtnText" FontSize="12"/>
                    </Button>
                </StackPanel>
                <!-- с разделителями по дням WPF по умолчанию создаёт ВСЕ записи сразу (и декодирует все картинки) — вкладка замирала на секунды;
                     включаем «ленивую» отрисовку и для групп -->
                <ListBox x:Name="List" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <!-- разделители по дням: по центру дата, по бокам тонкие линии -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6,4,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Height="1" VerticalAlignment="Center">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#0022222A" Offset="0"/>
                                                    <GradientStop Color="#FF2A2A33" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Column="1" Background="#121216" BorderBrush="#24242B" BorderThickness="1" CornerRadius="10" Padding="12,3" Margin="10,0">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource DayTitle}}" FontSize="11" FontWeight="SemiBold" Foreground="#9A9AA5"/>
                                        </Border>
                                        <Border Grid.Column="2" Height="1" VerticalAlignment="Center">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF2A2A33" Offset="0"/>
                                                    <GradientStop Color="#0022222A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="row" Background="{DynamicResource Card}" CornerRadius="12" Padding="12,9" Cursor="Hand"
                                    MouseLeftButtonUp="OnItemClick" PreviewMouseLeftButtonDown="OnRowDown" MouseMove="OnRowMove" Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Top">
                                        <Border x:Name="textIcon" Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Plate}">
                                            <TextBlock Text="{Binding Letter}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="kindIcon" Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Plate}" Visibility="Collapsed">
                                            <h:Icon Kind="{Binding IconKind}" Width="15" Height="15" Foreground="{DynamicResource Muted}"/>
                                        </Border>
                                        <Border x:Name="swatch" Width="28" Height="28" CornerRadius="8" Background="{Binding Swatch}" BorderBrush="#3A3A42" BorderThickness="1" Visibility="Collapsed"/>
                                        <Border x:Name="imgIcon" Width="56" Height="36" CornerRadius="8" Background="{DynamicResource Plate}" ClipToBounds="True" Visibility="Collapsed"
                                                Cursor="Hand" ToolTip="Посмотреть" MouseLeftButtonUp="OnThumbClick" Tag="{Binding}">
                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                        <TextBlock Text="{Binding Preview}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel x:Name="actions" Grid.Column="2" Orientation="Horizontal" Visibility="Hidden">
                                        <Button x:Name="actBtn" Style="{StaticResource Ghost}" Click="OnAction" Tag="{Binding}" ToolTip="{Binding ActionTip}" Visibility="Collapsed">
                                            <h:Icon Kind="{Binding ActionIcon}" Width="14" Height="14"/>
                                        </Button>
                                        <Button Style="{StaticResource Ghost}" Click="OnFolderMenu" Tag="{Binding}" ToolTip="В папку">
                                            <h:Icon Kind="Folder" Width="14" Height="14"/>
                                        </Button>
                                        <Button Style="{StaticResource Ghost}" Click="OnPin" Tag="{Binding}" ToolTip="Закрепить">
                                            <h:Icon Kind="Pin" Width="14" Height="14"/>
                                        </Button>
                                        <Button Style="{StaticResource Ghost}" Click="OnDelete" Tag="{Binding}" ToolTip="Удалить">
                                            <h:Icon Kind="Close" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Visual}" Value="icon">
                                    <Setter TargetName="textIcon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="kindIcon" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Visual}" Value="swatch">
                                    <Setter TargetName="textIcon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="swatch" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Visual}" Value="thumb">
                                    <Setter TargetName="textIcon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="imgIcon" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasAction}" Value="True">
                                    <Setter TargetName="actBtn" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{StaticResource CardHover}"/>
                                    <Setter TargetName="row" Property="BorderBrush" Value="#34343C"/>
                                    <Setter TargetName="row" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="row" Property="Padding" Value="11,8"/>
                                </DataTrigger>
                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{StaticResource CardHover}"/>
                                    <Setter TargetName="actions" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>

        <!-- просмотр картинки: вырастает из миниатюры, колёсико — масштаб, перетаскивание — сдвиг -->
        <Grid x:Name="Viewer" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="-6">
            <Border x:Name="ViewerBack" Background="#F2050507" CornerRadius="14" Opacity="0" MouseLeftButtonUp="OnViewerBackClick"/>
            <Canvas x:Name="ViewerCanvas" ClipToBounds="True" IsHitTestVisible="True" Background="{x:Null}">
                <Border x:Name="ViewerFrame" Background="#0E0E10" ClipToBounds="True"
                        MouseWheel="OnViewerWheel" MouseLeftButtonDown="OnViewerDown" MouseMove="OnViewerMove" MouseLeftButtonUp="OnViewerUp">
                    <Image x:Name="ViewerImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </Canvas>
            <Border x:Name="ViewerBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0"
                    Background="#E6141418" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="16" Padding="6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ViewerInfo" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="10,0,12,0"/>
                    <Button Style="{StaticResource Ghost}" Padding="10,6" Click="OnViewerCopy" ToolTip="Скопировать картинку">
                        <StackPanel Orientation="Horizontal"><h:Icon Kind="Copy" Width="14" Height="14"/><TextBlock Text="Копировать" FontSize="12" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                    <Button x:Name="ViewerSaveBtn" Style="{StaticResource Ghost}" Padding="10,6" Click="OnViewerSave" ToolTip="Сохранить как…">
                        <StackPanel Orientation="Horizontal"><h:Icon Kind="Download" Width="14" Height="14"/><TextBlock Text="Сохранить" FontSize="12" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Ghost}" Padding="10,6" Click="OnViewerOpen" ToolTip="Открыть в программе для фото">
                        <StackPanel Orientation="Horizontal"><h:Icon Kind="External" Width="14" Height="14"/><TextBlock Text="Открыть" FontSize="12" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Ghost}" Padding="8,6" Click="OnViewerClose" ToolTip="Закрыть (Esc)" Margin="4,0,0,0">
                        <h:Icon Kind="Close" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </Border>
</UserControl>
