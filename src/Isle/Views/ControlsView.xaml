<UserControl x:Class="Isle.Views.ControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Isle.Helpers">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="Power" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <UniformGrid Columns="4">
            <Button Style="{StaticResource Tile}" Margin="0,0,5,0" Click="OnNetwork" ToolTip="Параметры сети">
                <DockPanel>
                    <Border DockPanel.Dock="Top" x:Name="NetDot" Width="36" Height="36" CornerRadius="18" Background="#1C1C20" HorizontalAlignment="Left">
                        <h:Icon Kind="Wifi" Width="16" Height="16"/>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Name="NetName" Text="Сеть" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NetStatus" Text="—" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Style="{StaticResource Tile}" Margin="5,0" Click="OnBluetooth" ToolTip="Включить / выключить Bluetooth">
                <DockPanel>
                    <Border DockPanel.Dock="Top" x:Name="BtDot" Width="36" Height="36" CornerRadius="18" Background="#1C1C20" HorizontalAlignment="Left">
                        <h:Icon x:Name="BtIcon" Kind="Bluetooth" Width="16" Height="16"/>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Bluetooth" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BtStatus" Text="—" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Style="{StaticResource Tile}" Margin="5,0" Click="OnTheme" ToolTip="Тёмная / светлая тема Windows">
                <DockPanel>
                    <Border DockPanel.Dock="Top" x:Name="ThemeDot" Width="36" Height="36" CornerRadius="18" Background="#1C1C20" HorizontalAlignment="Left">
                        <h:Icon x:Name="ThemeIcon" Kind="Contrast" Width="16" Height="16"/>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Тёмная тема" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ThemeStatus" Text="—" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Style="{StaticResource Tile}" Margin="5,0,0,0" Click="OnTaskMgr" ToolTip="Диспетчер задач">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="18" Background="#1C1C20" HorizontalAlignment="Left">
                        <h:Icon Kind="Wave" Width="16" Height="16"/>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Диспетчер" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LoadText" Text="задач" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Button>
        </UniformGrid>

        <!-- Звук прямо в острове -->
        <Border Grid.Row="2" Style="{StaticResource CardBox}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Ghost}" Click="OnMute" ToolTip="Выключить / включить звук">
                    <h:Icon x:Name="VolIcon" Kind="Volume" Width="16" Height="16"/>
                </Button>
                <Slider x:Name="Volume" Grid.Column="1" Minimum="0" Maximum="100" Margin="8,0" VerticalAlignment="Center" ValueChanged="OnVolume"/>
                <TextBlock x:Name="VolText" Grid.Column="2" Text="0" Width="26" FontSize="12" Foreground="#B9B9C3" VerticalAlignment="Center" TextAlignment="Right"/>
                <ComboBox x:Name="Devices" Grid.Column="3" Width="220" Margin="10,0,0,0" SelectionChanged="OnDevice" DropDownOpened="OnDevicesOpen" DropDownClosed="OnDevicesClosed"/>
                <ToggleButton x:Name="MicBtn" Grid.Column="4" Style="{StaticResource Chip}" Margin="8,0,0,0" Height="34" Click="OnMic" ToolTip="Микрофон: выключить / включить">
                    <h:Icon Kind="Mic" Width="14" Height="14"/>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Питание: первое нажатие краснеет и запускает полоску, второе — выполняет -->
        <UniformGrid Grid.Row="4" Columns="4">
            <Button x:Name="LockBtn" Style="{StaticResource Power}" Margin="0,0,5,0" Click="OnPower" Tag="lock">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <h:Icon Kind="Lock" Width="16" Height="16" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LockText" Text="Блокировка" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Border x:Name="LockBar" Grid.Row="1" Height="3" VerticalAlignment="Center" Margin="10,0,10,7" CornerRadius="1.5" Background="#F87171" RenderTransformOrigin="0,0.5" Visibility="Hidden">
                        <Border.RenderTransform><ScaleTransform ScaleX="1"/></Border.RenderTransform>
                    </Border>
                </Grid>
            </Button>
            <Button x:Name="SleepBtn" Style="{StaticResource Power}" Margin="5,0" Click="OnPower" Tag="sleep">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <h:Icon Kind="Moon" Width="16" Height="16" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SleepText" Text="Сон" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Border x:Name="SleepBar" Grid.Row="1" Height="3" VerticalAlignment="Center" Margin="10,0,10,7" CornerRadius="1.5" Background="#F87171" RenderTransformOrigin="0,0.5" Visibility="Hidden">
                        <Border.RenderTransform><ScaleTransform ScaleX="1"/></Border.RenderTransform>
                    </Border>
                </Grid>
            </Button>
            <Button x:Name="RestartBtn" Style="{StaticResource Power}" Margin="5,0" Click="OnPower" Tag="restart">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <h:Icon Kind="Restart" Width="16" Height="16" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RestartText" Text="Перезагрузка" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Border x:Name="RestartBar" Grid.Row="1" Height="3" VerticalAlignment="Center" Margin="10,0,10,7" CornerRadius="1.5" Background="#F87171" RenderTransformOrigin="0,0.5" Visibility="Hidden">
                        <Border.RenderTransform><ScaleTransform ScaleX="1"/></Border.RenderTransform>
                    </Border>
                </Grid>
            </Button>
            <Button x:Name="ShutdownBtn" Style="{StaticResource Power}" Margin="5,0,0,0" Click="OnPower" Tag="shutdown">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <h:Icon Kind="Power" Width="16" Height="16" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ShutdownText" Text="Выключение" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Border x:Name="ShutdownBar" Grid.Row="1" Height="3" VerticalAlignment="Center" Margin="10,0,10,7" CornerRadius="1.5" Background="#F87171" RenderTransformOrigin="0,0.5" Visibility="Hidden">
                        <Border.RenderTransform><ScaleTransform ScaleX="1"/></Border.RenderTransform>
                    </Border>
                </Grid>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
