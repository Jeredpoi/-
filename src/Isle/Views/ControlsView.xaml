<UserControl x:Class="Isle.Views.ControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Isle.Helpers">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="68"/>
        </Grid.RowDefinitions>

        <UniformGrid Columns="3">
            <Button Style="{StaticResource Tile}" Margin="0,0,6,0" Click="OnNetwork">
                <DockPanel>
                    <Border DockPanel.Dock="Top" x:Name="NetDot" Width="38" Height="38" CornerRadius="19" Background="{StaticResource Blue}" HorizontalAlignment="Left">
                        <h:Icon Kind="Wifi" Width="17" Height="17"/>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Name="NetName" Text="Сеть" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NetStatus" Text="—" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Style="{StaticResource Tile}" Margin="3,0" Click="OnBluetooth">
                <DockPanel>
                    <Border DockPanel.Dock="Top" x:Name="BtDot" Width="38" Height="38" CornerRadius="19" Background="#1C1C20" HorizontalAlignment="Left">
                        <h:Icon Kind="Bluetooth" Width="17" Height="17"/>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Bluetooth" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BtStatus" Text="—" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Style="{StaticResource Tile}" Margin="6,0,0,0" Click="OnTheme">
                <DockPanel>
                    <Border DockPanel.Dock="Top" x:Name="ThemeDot" Width="38" Height="38" CornerRadius="19" Background="#1C1C20" HorizontalAlignment="Left">
                        <h:Icon Kind="Contrast" Width="17" Height="17"/>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Тёмная тема" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ThemeStatus" Text="—" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                </DockPanel>
            </Button>
        </UniformGrid>

        <UniformGrid Grid.Row="2" Columns="4">
            <Button Style="{StaticResource Flat}" Height="36" Margin="0,0,4,0" Click="OnTaskMgr" Content="Диспетчер задач"/>
            <Button Style="{StaticResource Flat}" Height="36" Margin="4,0" Click="OnSettings" Content="Параметры Windows"/>
            <Button Style="{StaticResource Flat}" Height="36" Margin="4,0" Click="OnSound" Content="Звук"/>
            <Button Style="{StaticResource Flat}" Height="36" Margin="4,0,0,0" Click="OnShots" Content="Папка скриншотов"/>
        </UniformGrid>

        <UniformGrid Grid.Row="4" Columns="4">
            <Button Style="{StaticResource Flat}" Margin="0,0,5,0" Click="OnLock">
                <StackPanel><h:Icon Kind="Lock" Width="16" Height="16"/><TextBlock Text="Блокировка" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
            </Button>
            <Button Style="{StaticResource Flat}" Margin="5,0" Click="OnSleep" x:Name="SleepBtn">
                <StackPanel><h:Icon Kind="Moon" Width="16" Height="16"/><TextBlock x:Name="SleepText" Text="Сон" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
            </Button>
            <Button Style="{StaticResource Flat}" Margin="5,0" Click="OnRestart">
                <StackPanel><h:Icon Kind="Restart" Width="16" Height="16"/><TextBlock x:Name="RestartText" Text="Перезагрузка" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
            </Button>
            <Button Style="{StaticResource Flat}" Margin="5,0,0,0" Click="OnShutdown">
                <StackPanel><h:Icon Kind="Power" Width="16" Height="16"/><TextBlock x:Name="ShutdownText" Text="Выключение" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
