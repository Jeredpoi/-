<UserControl x:Class="Isle.Views.PhoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Isle.Helpers">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="QrCol" Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- QR-код: телефон сканирует камерой и открывает страничку -->
        <Border x:Name="PairCard" Style="{StaticResource CardBox}" Margin="0,0,14,0" Padding="16,18,16,14">
          <Border.RenderTransform><TranslateTransform x:Name="PairCardShift"/></Border.RenderTransform>
          <Grid>
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <WrapPanel x:Name="Networks" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="CopyLink" Style="{StaticResource Ghost}" Padding="10,5" Click="OnCopyLink">
                            <StackPanel Orientation="Horizontal"><h:Icon Kind="Link" Width="12" Height="12"/><TextBlock Text="Ссылка" FontSize="11" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Ghost}" Padding="10,5" Click="OnHelp">
                            <StackPanel Orientation="Horizontal"><h:Icon Kind="Info" Width="12" Height="12"/><TextBlock Text="Не открывается?" FontSize="11" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <!-- сам код: квадрат, размер подгоняется под целое число пикселей на клетку -->
                    <Grid x:Name="QrHost" HorizontalAlignment="Center" VerticalAlignment="Center" Width="184" Height="184">
                        <!-- ровный квадрат на чёрном: светлые клетки на чёрном фоне -->
                        <Border x:Name="QrCard" Background="Black">
                            <Grid>
                                <Image x:Name="Qr" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QrNone" Text="Нет сети" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <!-- ждёт телефон: оранжевая рамка «дышит» — разгорается и гаснет -->
                        <!-- свечение рисуется один раз в кэш, дальше меняется только прозрачность — почти бесплатно для ЦП -->
                        <Rectangle x:Name="Breath" Stroke="#FB923C" StrokeThickness="2" IsHitTestVisible="False" Opacity="0.25" SnapsToDevicePixels="True">
                            <Rectangle.CacheMode><BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True"/></Rectangle.CacheMode>
                            <Rectangle.Effect><DropShadowEffect Color="#FB923C" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/></Rectangle.Effect>
                        </Rectangle>
                        <!-- телефон открыл страничку: по краю пробегает зелёная змейка и замыкается в рамку -->
                        <Rectangle x:Name="Snake" Stroke="#4ADE80" StrokeThickness="3" StrokeDashCap="Flat"
                                   IsHitTestVisible="False" Opacity="0">
                            <Rectangle.Effect><DropShadowEffect x:Name="SnakeGlow" Color="#4ADE80" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/></Rectangle.Effect>
                        </Rectangle>
                        <Border x:Name="QrOk" Width="64" Height="64" CornerRadius="32" Background="#4ADE80" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="QrOkScale" ScaleX="0.5" ScaleY="0.5"/></Border.RenderTransform>
                            <Border.Effect><DropShadowEffect Color="#000" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                            <h:Icon Kind="Check" Width="30" Height="30" StrokeWidth="3" Foreground="#05210F"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="QrTitle" Text="Наведи камеру телефона" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,3"/>
                    <TextBlock x:Name="QrSub" Text="Откроется страничка — без приложений" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Border x:Name="StatusPill" HorizontalAlignment="Center" Margin="0,12,0,0" CornerRadius="11" Padding="10,4" Background="{DynamicResource Plate}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusPulse" Fill="#4ADE80" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale"/></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="StatusDot" Fill="#6F6F79"/>
                            </Grid>
                            <TextBlock x:Name="StatusText" FontSize="11" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
            <!-- «Не открывается?» — подсказка прямо в карточке (раньше всплывала окошком и уходила под чёлку) -->
            <Border x:Name="HelpCard" Visibility="Collapsed" Opacity="0" Background="#141417" BorderBrush="#26262B" BorderThickness="1" CornerRadius="14"
                    Margin="-6,-8,-6,-4" Padding="16,14">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Flat}" Padding="14,7" HorizontalAlignment="Center" Margin="0,10,0,0" Click="OnHelp">
                        <TextBlock Text="Понятно" FontSize="12"/>
                    </Button>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Не открывается?" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,7"
                                   Text="1. Одна сеть: общий Wi-Fi или интернет с телефона (точка доступа, USB)."/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,7"
                                   Text="2. Разреши Isle в брандмауэре Windows для частных сетей."/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,7"
                                   Text="3. Несколько сетей — выбери другую над «Ссылкой» и отсканируй заново."/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,7"
                                   Text="4. VPN на телефоне — выключи на время."/>
                        <TextBlock x:Name="HttpsNote" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                        <Button x:Name="HttpsToggle" Style="{StaticResource Flat}" Padding="12,6" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnHttpsToggle">
                            <TextBlock x:Name="HttpsToggleText" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,4">
            <!-- телефон привязан: QR больше не нужен — его имя, связь и «Привязать заново» -->
            <Border x:Name="PairedBox" DockPanel.Dock="Right" Visibility="Collapsed" CornerRadius="12" Padding="10,4,4,4" Background="{DynamicResource Plate}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="PairedDot" Width="8" Height="8" Fill="#6F6F79" VerticalAlignment="Center"/>
                    <StackPanel Margin="8,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PairedName" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PairedState" FontSize="10" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                    <Button Style="{StaticResource Ghost}" Padding="8,5" Click="OnShowQr" ToolTip="Показать QR-код ещё раз — например, если закладка на телефоне потерялась">
                        <h:Icon Kind="Qr" Width="13" Height="13"/>
                    </Button>
                    <Button Style="{StaticResource Ghost}" Padding="8,5" Click="OnRepair" ToolTip="Новый ключ: старая ссылка перестанет открываться — отсканируй новый QR-код">
                        <StackPanel Orientation="Horizontal"><h:Icon Kind="Restart" Width="12" Height="12"/><TextBlock Text="Привязать заново" FontSize="11" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PaneFiles" Style="{StaticResource Segment}" GroupName="phonepane" IsChecked="True" Click="OnPane">
                    <StackPanel Orientation="Horizontal"><h:Icon Kind="Image" Width="13" Height="13"/><TextBlock Text="С телефона" Margin="7,0,0,0"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="PaneNotices" Style="{StaticResource Segment}" GroupName="phonepane" Click="OnPane">
                    <StackPanel Orientation="Horizontal"><h:Icon Kind="Bell" Width="13" Height="13"/><TextBlock Text="Уведомления" Margin="7,0,0,0"/>
                        <Border x:Name="NoticeBadge" Background="#4ADE80" CornerRadius="7" MinWidth="14" Height="14" Padding="4,0" Margin="7,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="NoticeCount" FontSize="9" FontWeight="Bold" Foreground="#05210F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Margin="0,6,0,0" Background="{DynamicResource Pane}" BorderBrush="{DynamicResource PaneBorder}" BorderThickness="1" CornerRadius="16"/>
            <!-- что пришло с телефона -->
            <Grid x:Name="FilesPane" Grid.Row="1" Margin="{DynamicResource PanePad}">
                <StackPanel x:Name="InEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
                    <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource Plate}" HorizontalAlignment="Center">
                        <h:Icon Kind="Phone" Width="20" Height="20" Foreground="{DynamicResource Muted}"/>
                    </Border>
                    <TextBlock Text="Пришли что-нибудь с телефона" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Фото, видео, файлы и текст появятся здесь и в «Буфере». Файлы сохраняются в «Загрузки\Isle с телефона»."/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="InList"/>
                </ScrollViewer>
            </Grid>

            <!-- уведомления телефона: их пересылает «Связь с телефоном» Windows по Bluetooth -->
            <Grid x:Name="NoticesPane" Grid.Row="1" Visibility="Collapsed" Margin="{DynamicResource PanePad}">
                <StackPanel x:Name="NoticesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                    <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource Plate}" HorizontalAlignment="Center">
                        <h:Icon Kind="Bluetooth" Width="20" Height="20" Foreground="{DynamicResource Muted}"/>
                    </Border>
                    <TextBlock Text="Уведомления телефона в чёлке" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Свяжи телефон в приложении «Связь с телефоном» — обычного подключения по Bluetooth в параметрах Windows мало. На iPhone потом включи «Показывать уведомления» для этого компьютера: Настройки → Bluetooth → (i) рядом с ним."/>
                    <Button Style="{StaticResource Flat}" Padding="14,7" Margin="0,12,0,0" HorizontalAlignment="Center" Click="OnOpenPhoneLink">
                        <StackPanel Orientation="Horizontal"><h:Icon Kind="Bluetooth" Width="13" Height="13"/><TextBlock Text="Подключить телефон" FontSize="12" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                    <TextBlock x:Name="NoticesHint" Style="{StaticResource MutedText}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NoticeList"/>
                </ScrollViewer>
            </Grid>

            <!-- на телефон: перетащи файлы сюда -->
            <Border x:Name="Drop" Grid.Row="2" Margin="0,10,0,0" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}" Background="{DynamicResource Card}" Padding="14,10"
                    AllowDrop="True" Drop="OnDrop" DragEnter="OnDragEnter" DragLeave="OnDragLeave">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Flat}" Padding="12,6" Margin="0,0,6,0" Click="OnPickFiles">
                                <StackPanel Orientation="Horizontal"><h:Icon Kind="File" Width="13" Height="13"/><TextBlock Text="Файлы…" FontSize="12" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Flat}" Padding="12,6" Click="OnSendClipboard" ToolTip="Текст из буфера обмена — на страничку телефона">
                                <StackPanel Orientation="Horizontal"><h:Icon Kind="Clipboard" Width="13" Height="13"/><TextBlock Text="Буфер" FontSize="12" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource Plate}" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center">
                            <h:Icon Kind="Send" Width="14" Height="14" Foreground="{DynamicResource Muted}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="На телефон" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OutHint" Style="{StaticResource MutedText}" FontSize="11" Text="Перетащи сюда файлы — на телефоне появится «Скачать»"/>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel x:Name="OutList" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
