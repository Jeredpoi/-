<UserControl x:Class="Isle.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="H" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource H}" Text="ЭКРАН" Margin="0,0,0,6"/>
                <CheckBox x:Name="Oled" Content="OLED-режим: прятать чёлку полностью" Click="OnOled"/>
                <TextBlock Style="{StaticResource Note}" Text="Чёлка уезжает за верхний край. Наведи курсор на верх экрана — появится на заданное время."/>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock x:Name="OledSecText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" FontSize="12"/>
                    <TextBlock Text="Показывать" FontSize="12" Width="90" VerticalAlignment="Center"/>
                    <Slider x:Name="OledSec" Minimum="3" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnOledSec" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock x:Name="ScaleText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" FontSize="12"/>
                    <TextBlock Text="Размер" FontSize="12" Width="90" VerticalAlignment="Center"/>
                    <Slider x:Name="ScaleSlider" Minimum="70" Maximum="160" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnScale" VerticalAlignment="Center"/>
                </DockPanel>
                <CheckBox x:Name="Hover" Content="Открывать при наведении" Click="OnToggle"/>
                <CheckBox x:Name="Fullscreen" Content="Прятать в полноэкранных играх и видео" Click="OnToggle"/>
                <CheckBox x:Name="Clock24" Content="24-часовой формат" Click="OnToggle"/>
                <CheckBox x:Name="Captures" Content="Показывать остров на скриншотах и в записи" Click="OnCaptures"/>
                <TextBlock Style="{StaticResource Note}" Text="Обычно его там не видно: ни скриншоты, ни запись, ни трансляция остров не захватывают."/>
                <CheckBox x:Name="Autostart" Content="Запускать вместе с Windows" Click="OnAutostart"/>

                <TextBlock Style="{StaticResource H}" Text="ВСПЛЫВАШКИ"/>
                <CheckBox x:Name="Media" Content="Музыка в свёрнутой чёлке" Click="OnToggle"/>
                <CheckBox x:Name="Lyrics" Content="Текст песен (LRCLIB)" Click="OnToggle"/>
                <CheckBox x:Name="Volume" Content="Громкость" Click="OnToggle"/>
                <CheckBox x:Name="Layout" Content="Смена раскладки" Click="OnToggle"/>
                <CheckBox x:Name="Caps" Content="Caps Lock" Click="OnToggle"/>
                <CheckBox x:Name="Battery" Content="Зарядка и низкий заряд" Click="OnToggle"/>
                <CheckBox x:Name="Notif" Content="Уведомления других приложений" Click="OnToggle"/>
                <TextBlock x:Name="NotifStatus" Style="{StaticResource Note}"/>
                <CheckBox x:Name="ClipHist" Content="История буфера обмена" Click="OnToggle"/>
                <CheckBox x:Name="ClipImg" Content="Сохранять в истории картинки" Click="OnToggle"/>
                <CheckBox x:Name="Vpn" Content="Статус VPN и страна" Click="OnToggle"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource H}" Text="ПОГОДА" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CityBox" Tag="Город" Padding="10,7" FontSize="12"/>
                    <Button Grid.Column="1" Style="{StaticResource Flat}" Margin="8,0,0,0" Content="Найти" Click="OnCity"/>
                </Grid>
                <TextBlock x:Name="CityStatus" Style="{StaticResource Note}" Margin="0,4,0,0"/>

                <TextBlock Style="{StaticResource H}" Text="ИИ-ЧАТ"/>
                <ComboBox x:Name="Provider" SelectionChanged="OnProvider" Margin="0,0,0,8">
                    <ComboBoxItem Tag="anthropic" Content="Anthropic (Claude)"/>
                    <ComboBoxItem Tag="openai" Content="OpenAI-совместимый (OpenAI, Gemini, Groq, OpenRouter, Ollama…)"/>
                </ComboBox>
                <TextBlock Text="API-ключ" FontSize="12" Margin="0,0,0,4"/>
                <PasswordBox x:Name="Key"/>
                <TextBlock Text="Модель" FontSize="12" Margin="0,8,0,4"/>
                <TextBox x:Name="Model" Padding="10,7" FontSize="12"/>
                <StackPanel x:Name="EndpointPanel">
                    <TextBlock Text="Адрес API (chat/completions)" FontSize="12" Margin="0,8,0,4"/>
                    <TextBox x:Name="Endpoint" Padding="10,7" FontSize="12"/>
                </StackPanel>
                <Button Style="{StaticResource Primary}" Content="Сохранить настройки ИИ" Margin="0,10,0,0" Height="34" Click="OnSaveAi"/>
                <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0" Text="Ключ шифруется средствами Windows и хранится только на этом компьютере."/>

                <TextBlock Style="{StaticResource H}" Text="ГОРЯЧИЕ КЛАВИШИ"/>
                <TextBlock Style="{StaticResource Note}" Text="Ctrl+Alt+Space — открыть / закрыть остров"/>
                <TextBlock Style="{StaticResource Note}" Text="Ctrl+Alt+K — командная строка (калькулятор, запуск, таймер, напоминание)"/>
                <TextBlock Style="{StaticResource Note}" Text="Ctrl+Alt+V — история буфера"/>
                <TextBlock Style="{StaticResource Note}" Text="Ctrl+Alt+S — снимок области"/>
                <TextBlock Style="{StaticResource Note}" Text="Esc — свернуть · правый клик по чёлке — меню"/>

                <TextBlock Style="{StaticResource H}" Text="О ПРОГРАММЕ"/>
                <TextBlock x:Name="About" Style="{StaticResource Note}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Style="{StaticResource Flat}" Content="Папка данных" Click="OnDataDir"/>
                    <Button Style="{StaticResource Flat}" Content="Выйти из Isle" Margin="8,0,0,0" Click="OnExit"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
