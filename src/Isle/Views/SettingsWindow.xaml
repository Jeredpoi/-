                                    <TextBlock Style="{StaticResource RowNote}" Text="Реже путает языки"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Sep}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="VoicePunct" Click="OnToggle"/>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Знаки препинания"/>
                                        <TextBlock Style="{StaticResource Info}" ToolTip="После распознавания ИИ из раздела «ИИ» расставит точки, запятые и заглавные буквы. Слова не меняются."/>
