                                    <RadioButton Style="{StaticResource SSegment}" GroupName="vp" x:Name="VpPolza" Click="OnVoicePreset" Tag="polza" Content="Polza.ai"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="vp" x:Name="VpOpenAi" Click="OnVoicePreset" Tag="openai" Content="OpenAI"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="vp" x:Name="VpCustom" Click="OnVoicePreset" Tag="custom" Content="Свой"/>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Сервис"/>
