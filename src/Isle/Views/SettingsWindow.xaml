                                </Button>
                                <TextBox DockPanel.Dock="Right" x:Name="VoiceModel" Width="250" Tag="модель" LostFocus="OnVoiceFields"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Модель"/>
                            </DockPanel>
                            <Border Style="{StaticResource Sep}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SFlat}" Content="Сохранить" Margin="8,0,0,0" Click="OnVoiceSaveKey"/>
                                <PasswordBox DockPanel.Dock="Right" x:Name="VoiceKey" Width="200" Tag="Вставь ключ"/>
