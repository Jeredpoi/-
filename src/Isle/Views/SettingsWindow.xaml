<Window x:Class="Isle.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:Isle.Helpers"
        Title="Isle — настройки" Width="900" Height="700" MinWidth="760" MinHeight="520"
        Background="#0A0A0C" Foreground="{StaticResource Fg}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Icon="pack://application:,,,/Isle;component/app.ico">
    <Window.Resources>
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B9B9C3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="12,9">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter Content="{TemplateBinding Tag}" VerticalAlignment="Center"/>
                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#141417"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1C1C20"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0E0E10"/>
            <Setter Property="BorderBrush" Value="#1C1C20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8B8B95"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#1C1C20"/>
            <Setter Property="Margin" Value="-18,0"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Меню разделов -->
        <DockPanel Background="#060607" >
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,22">
                <Border Width="44" Height="22" CornerRadius="11" Background="Black" BorderBrush="#3A3A42" BorderThickness="1">
                    <h:Character Width="30" Height="18"/>
                </Border>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="Isle" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="VersionText" Text="Версия" FontSize="11" Foreground="#8B8B95"/>
                </StackPanel>
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Style="{StaticResource Ghost}" Margin="14,0,14,18" HorizontalContentAlignment="Left" Click="OnExit">
                <StackPanel Orientation="Horizontal">
                    <h:Icon Kind="Power" Width="15" Height="15" Foreground="#F87171"/>
                    <TextBlock Text="Выйти из Isle" Margin="10,0,0,0" Foreground="#F87171" FontSize="13"/>
                </StackPanel>
            </Button>
            <TextBlock DockPanel.Dock="Bottom" Text="Изменения сохраняются сразу" FontSize="11" Foreground="#6F6F79" Margin="26,0,0,10"/>
            <StackPanel x:Name="NavPanel" Margin="12,0">
                <RadioButton Style="{StaticResource Nav}" Content="Общее" Tag="{h:IconFor Sliders}" x:Name="NavGeneral" IsChecked="True" Checked="OnNav"/>
                <RadioButton Style="{StaticResource Nav}" Content="Внешний вид" Tag="{h:IconFor Contrast}" x:Name="NavLook" Checked="OnNav"/>
                <RadioButton Style="{StaticResource Nav}" Content="ИИ" Tag="{h:IconFor Chat}" x:Name="NavAi" Checked="OnNav"/>
                <RadioButton Style="{StaticResource Nav}" Content="Голос в текст" Tag="{h:IconFor Mic}" x:Name="NavVoice" Checked="OnNav"/>
                <RadioButton Style="{StaticResource Nav}" Content="Запись экрана" Tag="{h:IconFor Record}" x:Name="NavRecord" Checked="OnNav"/>
                <RadioButton Style="{StaticResource Nav}" Content="Погода" Tag="{h:IconFor Sun}" x:Name="NavWeather" Checked="OnNav"/>
                <RadioButton Style="{StaticResource Nav}" Content="Всплывашки и модули" Tag="{h:IconFor Bell}" x:Name="NavModules" Checked="OnNav"/>
                <RadioButton Style="{StaticResource Nav}" Content="Клавиши" Tag="{h:IconFor Keyboard}" x:Name="NavKeys" Checked="OnNav"/>
                <Border Height="1" Background="#1C1C20" Margin="10,10,10,10"/>
                <RadioButton Style="{StaticResource Nav}" Tag="{h:IconFor Restart}" x:Name="NavUpdates" Checked="OnNav">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Обновления"/>
                        <Border x:Name="UpdateDot" Width="7" Height="7" CornerRadius="3.5" Background="#4ADE80" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" x:Name="Scroll">
            <Grid Margin="32,26,32,26">

                <!-- ============ ОБЩЕЕ ============ -->
                <StackPanel x:Name="SecGeneral">
                    <TextBlock Style="{StaticResource H1}" Text="Общее"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,70,0"><TextBlock Style="{StaticResource RowTitle}" Text="Запускать вместе с Windows"/></StackPanel>
                                <CheckBox x:Name="Autostart" HorizontalAlignment="Right" Click="OnAutostart"/>
                            </Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,70,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Прятать в полноэкранных приложениях"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Игры, видео на весь экран, презентации. Навёл курсор на верхний край — остров выглянет."/>
                                </StackPanel>
                                <CheckBox x:Name="Fullscreen" HorizontalAlignment="Right" Click="OnToggle"/>
                            </Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,70,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Прятать остров, пока он не нужен (OLED)"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Остров уезжает за верхний край и не выжигает экран. Подведи курсор к самому верху — появится. Клик мимо — снова спрячется."/>
                                </StackPanel>
                                <CheckBox x:Name="Oled" HorizontalAlignment="Right" Click="OnOled"/>
                            </Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,70,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Показывать остров на скриншотах и в записи экрана"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Обычно его там нет: ни скриншоты, ни запись, ни трансляция остров не видят."/>
                                </StackPanel>
                                <CheckBox x:Name="Captures" HorizontalAlignment="Right" Click="OnCaptures"/>
                            </Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,70,0"><TextBlock Style="{StaticResource RowTitle}" Text="Открывать при наведении"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Если выключить — остров открывается кликом или Ctrl+Alt+Space."/></StackPanel>
                                <CheckBox x:Name="Hover" HorizontalAlignment="Right" Click="OnToggle"/>
                            </Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,70,0"><TextBlock Style="{StaticResource RowTitle}" Text="24-часовой формат времени"/></StackPanel>
                                <CheckBox x:Name="Clock24" HorizontalAlignment="Right" Click="OnToggle"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,70,0"><TextBlock Style="{StaticResource RowTitle}" Text="Данные Isle"/>
                                    <TextBlock Style="{StaticResource RowNote}" x:Name="DataDirText"/></StackPanel>
                                <Button Style="{StaticResource Flat}" Content="Открыть папку" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnDataDir"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ВНЕШНИЙ ВИД ============ -->
                <StackPanel x:Name="SecLook" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Внешний вид"/>
                    <!-- превью свёрнутого острова -->
                    <Border Background="#0E0E10" BorderBrush="#1C1C20" BorderThickness="1" CornerRadius="16" Height="150" Margin="0,0,0,14">
                        <Grid>
                            <Border x:Name="Preview" Background="Black" CornerRadius="0,0,16,16" HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Height="34" Padding="16,0" BorderBrush="#26262B" BorderThickness="1,0,1,1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <h:Character x:Name="PreviewBuddy" Width="30" Height="22" Margin="0,0,10,0"/>
                                    <StackPanel x:Name="PreviewEyes" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border Width="7" Height="14" CornerRadius="3.5" Background="#ECECF1"/>
                                        <Border Width="7" Height="14" CornerRadius="3.5" Background="#ECECF1" Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PreviewTime" Text="12:19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text=" · 18°" Foreground="#A1A1AB" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Свёрнутый остров" FontSize="11" Foreground="#6F6F79" VerticalAlignment="Bottom" Margin="14,0,0,10"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Персонаж"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Клоди живёт в чёлке: пляшет под музыку, думает вместе с ИИ, радуется готовому и засыпает, когда тебя нет."/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ch" Content="Клоди" x:Name="ChPixel" Click="OnCharacter" Tag="pixel"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ch" Content="Глаза" x:Name="ChEyes" Click="OnCharacter" Tag="eyes"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="ch" Content="Без персонажа" x:Name="ChNone" Click="OnCharacter" Tag="none"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Акцент"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Цвет кнопок, таймера и полосок музыки. По умолчанию — белый."/>
                                    <WrapPanel x:Name="Accents" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Размер острова"/><TextBlock Style="{StaticResource RowNote}" Text="На 4K-мониторе сделай крупнее"/></StackPanel>
                                <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="70" Maximum="200" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" ValueChanged="OnScale"/>
                                <TextBlock x:Name="ScaleText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource RowTitle}" Text="Непрозрачность"/><TextBlock Style="{StaticResource RowNote}" Text="Чуть видно рабочий стол сквозь остров"/></StackPanel>
                                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="50" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" ValueChanged="OnOpacity"/>
                                <TextBlock x:Name="OpacityText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ИИ ============ -->
                <StackPanel x:Name="SecAi" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="ИИ"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,12">
                            <WrapPanel x:Name="AiPresets"/>
                            <TextBlock x:Name="AiNote" Style="{StaticResource RowNote}" Margin="0,4,0,0"/>
                            <TextBlock Style="{StaticResource RowNote}" Foreground="#C9A15B" Margin="0,6,0,0"
                                       Text="Groq, Gemini и OpenRouter доступны не во всех странах: если сервис не отвечает, включи VPN или выбери другой."/>
                            <Button x:Name="AiKeyLink" Style="{StaticResource Ghost}" Padding="0" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnAiKeyLink">
                                <TextBlock Text="Получить ключ →" TextDecorations="Underline" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,12">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Ключ API"/>
                            <TextBlock Style="{StaticResource RowNote}" Text="Хранится только на этом компьютере, зашифрован средствами Windows и никому не передаётся."/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="AiKey"/>
                                <Button Grid.Column="1" Style="{StaticResource Flat}" Content="Сохранить" Margin="8,0,0,0" Click="OnAiSaveKey"/>
                                <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="Удалить" Foreground="#F87171" Margin="6,0,0,0" Click="OnAiDeleteKey"/>
                            </Grid>
                            <TextBlock x:Name="AiKeyState" Style="{StaticResource RowNote}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,12">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Адрес API и модель"/>
                            <TextBlock Style="{StaticResource RowNote}" Text="Кнопка сервиса выше подставляет их сама. «Список» показывает все модели, доступные твоему ключу."/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="AiBase" Tag="https://…/v1" LostFocus="OnAiFieldsChanged"/>
                                <TextBox x:Name="AiModel" Grid.Column="1" Margin="8,0,0,0" Tag="модель" LostFocus="OnAiFieldsChanged"/>
                                <Button x:Name="ModelsBtn" Grid.Column="2" Style="{StaticResource Flat}" Margin="8,0,0,0" Click="OnModels">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Список"/><h:Icon Kind="Next" Width="11" Height="11" Margin="6,0,0,0" RenderTransformOrigin="0.5,0.5"><h:Icon.RenderTransform><RotateTransform Angle="90"/></h:Icon.RenderTransform></h:Icon></StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource Primary}" Content="Проверить" Click="OnAiTest" Padding="16,8"/>
                                <TextBlock x:Name="AiTestResult" Style="{StaticResource RowNote}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ГОЛОС ============ -->
                <StackPanel x:Name="SecVoice" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Голос в текст"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,12">
                            <TextBlock Style="{StaticResource RowNote}" Margin="0" Text="Нажми Ctrl+Alt+D, скажи и нажми ещё раз: текст окажется в буфере. Запись уходит в выбранный сервис распознавания (Whisper)."/>
                            <WrapPanel Margin="0,12,0,0">
                                <RadioButton Style="{StaticResource Segment}" GroupName="vp" x:Name="VpGroq" Click="OnVoicePreset" Tag="groq">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Groq · Whisper"/><Border Background="#1F2A22" CornerRadius="6" Padding="5,1" Margin="8,0,0,0"><TextBlock Text="бесплатно" FontSize="10" Foreground="#8BD49E"/></Border></StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="vp" x:Name="VpOpenAi" Click="OnVoicePreset" Tag="openai" Content="OpenAI · Whisper"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="vp" x:Name="VpCustom" Click="OnVoicePreset" Tag="custom" Content="Свой адрес"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowNote}" Text="Groq: бесплатно, до 8 часов речи в день, отвечает за секунду и хорошо понимает русский. Тот же ключ, что и в разделе «ИИ»."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,12">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Адрес API и модель"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="VoiceBase" LostFocus="OnVoiceFields"/>
                                <TextBox x:Name="VoiceModel" Grid.Column="1" Margin="8,0,0,0" LostFocus="OnVoiceFields"/>
                            </Grid>
                            <TextBlock Style="{StaticResource RowTitle}" Text="Ключ распознавания" Margin="0,16,0,0"/>
                            <TextBlock Style="{StaticResource RowNote}" Text="Можно оставить пустым, если в разделе «ИИ» выбран тот же сервис: у Groq и OpenAI один ключ подходит и для чата, и для диктовки."/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="VoiceKey"/>
                                <Button Grid.Column="1" Style="{StaticResource Flat}" Content="Сохранить" Margin="8,0,0,0" Click="OnVoiceSaveKey"/>
                            </Grid>
                            <TextBlock x:Name="VoiceKeyState" Style="{StaticResource RowNote}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,260,0"><TextBlock Style="{StaticResource RowTitle}" Text="Язык речи"/><TextBlock Style="{StaticResource RowNote}" Text="Подсказка сервису: с ней он реже путает языки"/></StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="vl" x:Name="VlAuto" Content="Сам определит" Tag="" Click="OnVoiceLang"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="vl" x:Name="VlRu" Content="Русский" Tag="ru" Click="OnVoiceLang"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="vl" x:Name="VlEn" Content="English" Tag="en" Click="OnVoiceLang"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,70,0"><TextBlock Style="{StaticResource RowTitle}" Text="Сразу вставлять текст"/><TextBlock Style="{StaticResource RowNote}" Text="В окно, где стоял курсор. В буфере текст остаётся в любом случае."/></StackPanel>
                                <CheckBox x:Name="VoicePaste" HorizontalAlignment="Right" Click="OnToggle"/>
                            </Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12">
                                <Button Style="{StaticResource Primary}" Content="Проверить" Click="OnVoiceTest" Padding="16,8"/>
                                <TextBlock x:Name="VoiceTestResult" Style="{StaticResource RowNote}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ЗАПИСЬ ЭКРАНА ============ -->
                <StackPanel x:Name="SecRecord" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Запись экрана"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,12">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Через OBS"/>
                            <TextBlock Style="{StaticResource RowNote}" Text="Если OBS запущен, кнопка «Запись экрана» начинает и останавливает запись прямо в нём. В OBS включи: Инструменты → Настройки сервера WebSocket → «Включить сервер WebSocket». Если OBS не запущен, открываются «Ножницы» Windows."/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ObsPort" Tag="порт" LostFocus="OnObsFields"/>
                                <PasswordBox x:Name="ObsPass" Grid.Column="1" Margin="8,0,0,0"/>
                                <Button Grid.Column="2" Style="{StaticResource Flat}" Content="Сохранить пароль" Margin="8,0,0,0" Click="OnObsSave"/>
                            </Grid>
                            <Grid Margin="0,14,0,4">
                                <StackPanel Margin="0,0,70,0"><TextBlock Style="{StaticResource RowTitle}" Text="OBS: запись и трансляция в чёлке"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Пока OBS записывает или ведёт трансляцию, в чёлке горит REC или LIVE, а сохранённая запись приходит карточкой."/></StackPanel>
                                <CheckBox x:Name="ObsStatus" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnToggle"/>
                            </Grid>
                            <TextBlock Style="{StaticResource RowNote}" Text="Порт по умолчанию 4455. Пароль — тот, что показан в настройках сервера WebSocket (если включена аутентификация)."/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource Primary}" Content="Проверить подключение" Click="OnObsTest" Padding="16,8"/>
                                <TextBlock x:Name="ObsResult" Style="{StaticResource RowNote}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ПОГОДА ============ -->
                <StackPanel x:Name="SecWeather" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Погода"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,12">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Город"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="CityBox" Tag="Например, Шымкент" KeyDown="OnCityKey"/>
                                <Button Grid.Column="1" Style="{StaticResource Primary}" Content="Найти" Margin="8,0,0,0" Padding="16,8" Click="OnCity"/>
                            </Grid>
                            <TextBlock x:Name="CityStatus" Style="{StaticResource RowNote}"/>
                            <TextBlock Style="{StaticResource RowNote}" Text="Данные Open-Meteo — бесплатно и без ключа."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ МОДУЛИ ============ -->
                <StackPanel x:Name="SecModules" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Всплывашки и модули"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}"><TextBlock Style="{StaticResource RowTitle}" Text="Музыка в свёрнутой чёлке"/><CheckBox x:Name="Media" HorizontalAlignment="Right" Click="OnToggle"/></Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}"><TextBlock Style="{StaticResource RowTitle}" Text="Текст песен (LRCLIB)"/><CheckBox x:Name="Lyrics" HorizontalAlignment="Right" Click="OnToggle"/></Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}"><TextBlock Style="{StaticResource RowTitle}" Text="Громкость"/><CheckBox x:Name="Volume" HorizontalAlignment="Right" Click="OnToggle"/></Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}"><TextBlock Style="{StaticResource RowTitle}" Text="Смена раскладки"/><CheckBox x:Name="Layout" HorizontalAlignment="Right" Click="OnToggle"/></Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}"><TextBlock Style="{StaticResource RowTitle}" Text="Caps Lock"/><CheckBox x:Name="Caps" HorizontalAlignment="Right" Click="OnToggle"/></Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}"><TextBlock Style="{StaticResource RowTitle}" Text="Зарядка и низкий заряд"/><CheckBox x:Name="Battery" HorizontalAlignment="Right" Click="OnToggle"/></Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,70,0"><TextBlock Style="{StaticResource RowTitle}" Text="Уведомления других приложений"/><TextBlock x:Name="NotifStatus" Style="{StaticResource RowNote}"/></StackPanel>
                                <CheckBox x:Name="Notif" HorizontalAlignment="Right" Click="OnToggle"/>
                            </Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}"><TextBlock Style="{StaticResource RowTitle}" Text="Статус VPN и страна"/><CheckBox x:Name="Vpn" HorizontalAlignment="Right" Click="OnToggle"/></Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}"><TextBlock Style="{StaticResource RowTitle}" Text="История буфера обмена"/><CheckBox x:Name="ClipHist" HorizontalAlignment="Right" Click="OnToggle"/></Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,70,0"><TextBlock Style="{StaticResource RowTitle}" Text="Сохранять картинки"/><TextBlock Style="{StaticResource RowNote}" Text="Секретные копии из менеджеров паролей не сохраняются никогда."/></StackPanel>
                                <CheckBox x:Name="ClipImg" HorizontalAlignment="Right" Click="OnToggle"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ОБНОВЛЕНИЯ ============ -->
                <StackPanel x:Name="SecUpdates" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Обновления"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,14">
                            <Grid>
                                <StackPanel Margin="0,0,180,0">
                                    <TextBlock x:Name="UpdTitle" Style="{StaticResource RowTitle}" FontSize="16" Text="Isle"/>
                                    <TextBlock x:Name="UpdStatus" Style="{StaticResource RowNote}" Text="Нажми «Проверить»"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="UpdCheckBtn" Style="{StaticResource Flat}" Content="Проверить" Padding="14,8" Click="OnUpdateCheck"/>
                                    <Button x:Name="UpdInstallBtn" Style="{StaticResource Primary}" Content="Обновить" Padding="16,8" Margin="8,0,0,0" Click="OnUpdateInstall" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="UpdProgress" Height="6" Margin="0,14,0,0" Visibility="Collapsed">
                                <Border CornerRadius="3" Background="#26262B"/>
                                <Border x:Name="UpdBar" CornerRadius="3" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <TextBlock x:Name="UpdNotes" Style="{StaticResource RowNote}" Margin="0,14,0,0" Visibility="Collapsed" FontFamily="Consolas, Segoe UI"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,70,0"><TextBlock Style="{StaticResource RowTitle}" Text="Проверять обновления автоматически"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="При запуске и раз в 6 часов. О новой версии скажет всплывашка — обновляешься сам, одной кнопкой."/></StackPanel>
                                <CheckBox x:Name="AutoUpdate" HorizontalAlignment="Right" Click="OnToggle"/>
                            </Grid>
                            <Border Style="{StaticResource Sep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,140,0"><TextBlock Style="{StaticResource RowTitle}" Text="Все версии"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Список изменений и установщики на GitHub"/></StackPanel>
                                <Button Style="{StaticResource Flat}" Content="Открыть" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnReleases"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ КЛАВИШИ ============ -->
                <StackPanel x:Name="SecKeys" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="Клавиши"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="0,8" x:Name="KeysList"/>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
