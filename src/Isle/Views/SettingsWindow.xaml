<Window x:Class="Isle.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:Isle.Helpers"
        xmlns:v="clr-namespace:Isle.Views"
        Title="Isle — настройки" Width="980" Height="720" MinWidth="760" MinHeight="520"
        Background="#0A0A0C" Foreground="{StaticResource Fg}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Icon="pack://application:,,,/Isle;component/app.ico">
    <Window.Resources>
        <!-- цвета окна: в теме «Закат» подменяются (SettingsWindow.ApplyTheme) — фото пальм под тёмной вуалью и стекло -->
        <SolidColorBrush x:Key="SBg" Color="#0C0C0E"/>
        <SolidColorBrush x:Key="SSide" Color="#08080A"/>
        <SolidColorBrush x:Key="SCard" Color="#141417"/>
        <SolidColorBrush x:Key="SCardBorder" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="SField" Color="#1A1A1F"/>
        <SolidColorBrush x:Key="SFieldBorder" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="SBtn" Color="#1F1F24"/>
        <SolidColorBrush x:Key="SBtnBorder" Color="#2A2A30"/>
        <SolidColorBrush x:Key="SSeg" Color="#1A1A1E"/>
        <SolidColorBrush x:Key="SSegHover" Color="#232328"/>
        <SolidColorBrush x:Key="SSegSel" Color="#2C2C33"/>
        <SolidColorBrush x:Key="SNavHover" Color="#121215"/>
        <SolidColorBrush x:Key="SNavSel" Color="#1C1C21"/>
        <SolidColorBrush x:Key="SSep" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="SNote" Color="#8A8A96"/>
        <SolidColorBrush x:Key="SRowNote" Color="#7C7C86"/>
        <SolidColorBrush x:Key="SLabel" Color="#85858F"/>
        <SolidColorBrush x:Key="STile" Color="#1C1C21"/>
        <SolidColorBrush x:Key="SKeyCap" Color="#1E1E23"/>
        <SolidColorBrush x:Key="SKeyCapEdge" Color="#0E0E11"/>

        <!-- ===== поля ввода: высота 32, скругление 8, фокус — акцентом ===== -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource SField}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SFieldBorder}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource SRowNote}"
                                           VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsKeyboardFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- у пароля подсказка (Tag) включается из кода: PasswordBox не умеет «пусто» в триггерах -->
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Background" Value="{DynamicResource SField}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SFieldBorder}" BorderThickness="1" CornerRadius="8">
                            <Grid Margin="10,0">
                                <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource SRowNote}"
                                           VerticalAlignment="Center" Padding="2,0,0,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="32"/>
        </Style>
        <!-- переключатель в строке — справа, по центру -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== кнопки: высота 32, скругление 8 ===== -->
        <Style x:Key="SBtnBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
                            <Border x:Name="hov" CornerRadius="8" Background="#14FFFFFF" Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hov" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hov" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SFlat" TargetType="Button" BasedOn="{StaticResource SBtnBase}">
            <Setter Property="Background" Value="{DynamicResource SBtn}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SPrimary" TargetType="Button" BasedOn="{StaticResource SBtnBase}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="#08080A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
        <Style x:Key="SDanger" TargetType="Button" BasedOn="{StaticResource SBtnBase}">
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="SQuiet" TargetType="Button" BasedOn="{StaticResource SBtnBase}">
            <Setter Property="Foreground" Value="{DynamicResource SNote}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- ===== сегменты: одна «пилюля», выбранный — светлее и белым текстом ===== -->
        <Style x:Key="SSegBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SSeg}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SSegment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A6A6B0"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SSegHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SSegSel}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== меню слева: значок в плитке 22×22, выбранный — плитка цвета акцента ===== -->
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B4B4BE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="5,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="tile" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource STile}" TextElement.Foreground="#B4B4BE">
                                    <ContentPresenter Content="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SNavHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SNavSel}"/>
                                <Setter TargetName="tile" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="tile" Property="TextElement.Foreground" Value="#000000"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== страница ===== -->
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PageDesc" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource SNote}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SLabel}"/>
            <Setter Property="Margin" Value="12,20,0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <!-- строка: [значок] заголовок/пояснение … элемент справа; высота от 52 -->
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="16,10"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="LastChildFill" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- зависимая строка: сдвинута на 16 и гаснет, когда главный переключатель выключен -->
        <Style x:Key="SubRow" TargetType="DockPanel" BasedOn="{StaticResource Row}">
            <Setter Property="Margin" Value="32,10,16,10"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SRowNote}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- результат проверки: может быть длинным — переносится -->
        <Style x:Key="Result" TargetType="TextBlock" BasedOn="{StaticResource RowNote}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <!-- «ⓘ» рядом с заголовком: длинное объяснение — только во всплывающей подсказке -->
        <Style x:Key="Info" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Text" Value="ⓘ"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SLabel}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="6,1,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="80"/>
            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        </Style>
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SSep}"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
        </Style>
        <Style x:Key="SepIcon" TargetType="Border" BasedOn="{StaticResource Sep}">
            <Setter Property="Margin" Value="56,0,0,0"/>
        </Style>
        <Style x:Key="SepSub" TargetType="Border" BasedOn="{StaticResource Sep}">
            <Setter Property="Margin" Value="32,0,0,0"/>
        </Style>
        <!-- плитка 28×28 со значком слева в строке -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="{DynamicResource STile}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextElement.Foreground" Value="#D4D4DA"/>
        </Style>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Fill" Value="#6E6E78"/>
            <Setter Property="Margin" Value="0,1,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource SBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Меню разделов ================= -->
        <Border Background="{DynamicResource SSide}" BorderBrush="{DynamicResource SSep}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,18,16">
                    <Border Width="40" Height="20" CornerRadius="10" Background="Black" BorderBrush="#3A3A42" BorderThickness="1">
                        <h:Character Width="28" Height="17"/>
                    </Border>
                    <TextBlock Text="Isle" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- поиск по разделам: фильтрует пункты меню -->
                <TextBox x:Name="NavSearch" DockPanel.Dock="Top" Margin="12,0,12,12" Tag="Поиск" TextChanged="OnNavSearch"/>

                <!-- низ: версия и тихий выход -->
                <DockPanel DockPanel.Dock="Bottom" Margin="18,6,10,14" LastChildFill="False">
                    <TextBlock x:Name="VersionText" Text="Версия" FontSize="11" Foreground="{DynamicResource SLabel}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SQuiet}" Height="26" FontSize="11.5" Content="Закрыть Isle" Click="OnExit"/>
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Margin="10,0">
                        <RadioButton Style="{StaticResource Nav}" Content="Общее" Tag="{h:IconFor Sliders, Size=14}" x:Name="NavGeneral" IsChecked="True" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource Nav}" Content="Внешний вид" Tag="{h:IconFor Contrast, Size=14}" x:Name="NavLook" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource Nav}" Content="Персонаж" x:Name="NavCharacter" Checked="OnNav">
                            <RadioButton.Tag><h:Icon Width="14" Height="14" Data="M12 3a9 9 0 1 0 0.01 0 M8.5 14.5c1.8 2 5.2 2 7 0 M9 9.5v1 M15 9.5v1"/></RadioButton.Tag>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav}" Content="Чёлка" x:Name="NavNotch" Checked="OnNav">
                            <RadioButton.Tag><h:Icon Width="14" Height="14" Data="M3 6h4c0 2.2 1.8 4 4 4h2c2.2 0 4-1.8 4-4h4 M3 6v12h18V6"/></RadioButton.Tag>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Nav}" Content="Музыка" Tag="{h:IconFor Wave, Size=14}" x:Name="NavMusic" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource Nav}" Content="Уведомления" Tag="{h:IconFor Bell, Size=14}" x:Name="NavModules" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource Nav}" Content="Буфер обмена" Tag="{h:IconFor Clipboard, Size=14}" x:Name="NavClipboard" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource Nav}" Content="Снимки и запись" Tag="{h:IconFor Record, Size=14}" x:Name="NavRecord" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource Nav}" Content="ИИ" Tag="{h:IconFor Chat, Size=14}" x:Name="NavAi" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource Nav}" Content="Диктовка" Tag="{h:IconFor Mic, Size=14}" x:Name="NavVoice" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource Nav}" Content="Клавиши" Tag="{h:IconFor Keyboard, Size=14}" x:Name="NavKeys" Checked="OnNav"/>
                        <Border x:Name="NavSep" Height="1" Background="{DynamicResource SSep}" Margin="8,8"/>
                        <RadioButton Style="{StaticResource Nav}" Tag="{h:IconFor Info, Size=14}" x:Name="NavUpdates" Checked="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="О программе"/>
                                <Border x:Name="UpdateDot" Width="7" Height="7" CornerRadius="3.5" Background="#4ADE80" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" x:Name="Scroll" Background="Transparent">
            <Grid Margin="40,32,40,40" MaxWidth="680" HorizontalAlignment="Stretch">

                <!-- ============ ОБЩЕЕ ============ -->
                <StackPanel x:Name="SecGeneral">
                    <TextBlock Style="{StaticResource H1}" Text="Общее"/>
                    <TextBlock Style="{StaticResource PageDesc}" Text="Запуск и поведение острова"/>

                    <TextBlock Style="{StaticResource SectionLabel}" Margin="12,0,0,8" Text="ЗАПУСК"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel Style="{StaticResource Row}">
                            <CheckBox DockPanel.Dock="Right" x:Name="Autostart" Click="OnAutostart"/>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Power" Width="15" Height="15"/></Border>
                            <TextBlock Style="{StaticResource RowTitle}" Text="Запуск с Windows"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="ПОКАЗ ОСТРОВА"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="Fullscreen" Click="OnToggle"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Monitor" Width="15" Height="15"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Прятать в полноэкранных"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Игры и видео — курсор вверх, и он выглянет"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource SepIcon}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="Oled" Click="OnOled"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Moon" Width="15" Height="15"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Прятать до наведения"/>
                                        <TextBlock Style="{StaticResource Info}" ToolTip="Остров уезжает за верхний край и не выжигает экран. Подведи курсор к самому верху — появится. Клик мимо — снова спрячется."/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Бережёт OLED"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource SepIcon}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="Hover" Click="OnToggle"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="ChevRight" Width="15" Height="15" RenderTransformOrigin="0.5,0.5"><h:Icon.RenderTransform><RotateTransform Angle="-90"/></h:Icon.RenderTransform></h:Icon></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Открывать у края"/>
                                        <TextBlock x:Name="HoverNote" Style="{StaticResource Info}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Курсор к самому верху над чёлкой"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource SepIcon}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="Captures" Click="OnCaptures"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Image" Width="15" Height="15"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Виден на скриншотах и записи"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Обычно остров на них не попадает"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="ПОГОДА"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SFlat}" Content="Найти" Margin="8,0,0,0" Click="OnCity"/>
                            <TextBox DockPanel.Dock="Right" x:Name="CityBox" Width="220" Tag="Например, Шымкент" KeyDown="OnCityKey"/>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Sun" Width="15" Height="15"/></Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Город"/>
                                    <TextBlock Style="{StaticResource Info}" ToolTip="Прогноз MET Norway. От погоды зависят наряд Клоди и снег из-под чёлки."/>
                                </StackPanel>
                                <TextBlock x:Name="CityStatus" Style="{StaticResource RowNote}" MaxWidth="200" Visibility="Collapsed"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ВНЕШНИЙ ВИД ============ -->
                <StackPanel x:Name="SecLook" Style="{StaticResource Page}">
                    <TextBlock Style="{StaticResource H1}" Text="Внешний вид"/>
                    <TextBlock Style="{StaticResource PageDesc}" Text="Тема, цвет и размер острова"/>

                    <!-- превью свёрнутого острова и ряда вкладок -->
                    <Border Style="{StaticResource Card}" Height="132">
                        <Grid ClipToBounds="True">
                            <Border x:Name="Preview" Background="Black" CornerRadius="0,0,16,16" HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Height="34" Padding="16,0" BorderBrush="#26262B" BorderThickness="1,0,1,1" MouseEnter="OnPreviewEnter" MouseLeave="OnPreviewLeave">
                                <Border.LayoutTransform><ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/></Border.LayoutTransform>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <h:Character x:Name="PreviewBuddy" Width="36" Height="26" Margin="0,0,10,0"/>
                                    <StackPanel x:Name="PreviewEyes" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border Width="7" Height="14" CornerRadius="3.5" Background="#ECECF1"/>
                                        <Border Width="7" Height="14" CornerRadius="3.5" Background="#ECECF1" Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PreviewTime" Text="12:19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text=" · 18°" Foreground="#A1A1AB" VerticalAlignment="Center"/>
                                    <!-- полоски музыки цвета акцента — видно, как меняется акцент -->
                                    <StackPanel x:Name="PreviewBars" Orientation="Horizontal" VerticalAlignment="Center" Height="16" Margin="12,0,0,0">
                                        <Border Width="3" Height="6" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Bottom"/>
                                        <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="2,0,0,0"/>
                                        <Border Width="3" Height="9" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="2,0,0,0"/>
                                        <Border Width="3" Height="14" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="2,0,0,0"/>
                                        <Border Width="3" Height="8" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- ряд вкладок раскрытой чёлки — сразу видно порядок и какие спрятаны -->
                            <Border Background="Black" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"
                                    Padding="4" BorderBrush="#26262B" BorderThickness="1">
                                <StackPanel x:Name="PreviewTabs" Orientation="Horizontal"/>
                            </Border>
                            <TextBlock Text="Свёрнутая чёлка и вкладки" FontSize="11" Foreground="{DynamicResource SLabel}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="ТЕМА И АКЦЕНТ"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SSegBox}">
                                    <StackPanel x:Name="Themes" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="theme" Content="Тёмная" Click="OnTheme" Tag="dark"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="theme" Content="Закат" Click="OnTheme" Tag="sunset"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Тема"/>
                                    <TextBlock Style="{StaticResource Info}" ToolTip="«Закат» — неоновый вечер у океана: пальмы за матовым стеклом, розовый акцент, у Клоди гавайская рубашка."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Sep}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <Border x:Name="AccentsBox" DockPanel.Dock="Right" Style="{StaticResource SSegBox}">
                                    <WrapPanel x:Name="Accents" Orientation="Horizontal"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Акцент"/>
                                    <TextBlock x:Name="AccentNote" Style="{StaticResource RowNote}" Text="Цвет или градиент"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="РАЗМЕР И ПРОЗРАЧНОСТЬ"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="ScaleSlider" Width="200" Minimum="70" Maximum="200" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" ValueChanged="OnScale"/>
                                    <TextBlock x:Name="ScaleText" Width="48" TextAlignment="Right" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource SNote}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Размер"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="На 4K — крупнее"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Sep}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="OpacitySlider" Width="200" Minimum="50" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" ValueChanged="OnOpacity"/>
                                    <TextBlock x:Name="OpacityText" Width="48" TextAlignment="Right" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource SNote}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Непрозрачность"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Меньше — виден стол"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="ВЫРЕЗ И ПЛАВНОСТЬ"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SSegBox}">
                                    <StackPanel x:Name="NotchModes" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="notch" Content="Выкл" Click="OnNotchMode" Tag="off"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="notch" Content="В браузере" Click="OnNotchMode" Tag="browser"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="notch" Content="Всегда" Click="OnNotchMode" Tag="always"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Вырез сверху"/>
                                        <TextBlock Style="{StaticResource Info}" ToolTip="Сверху чёрная полоса высотой с чёлку, развёрнутые окна встают ниже — чёлка ничего не закрывает. «В браузере» — только пока впереди браузер на весь экран."/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Окна ниже чёлки, как на MacBook"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Sep}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SSegBox}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="fps" x:Name="Fps30" Content="30" Tag="30" Click="OnFps"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="fps" x:Name="Fps60" Content="60" Tag="60" Click="OnFps"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="fps" x:Name="Fps120" Content="120" Tag="120" Click="OnFps"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="fps" x:Name="FpsMax" Content="Как монитор" Tag="0" Click="OnFps"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Плавность"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Кадров в секунду"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ПЕРСОНАЖ ============ -->
                <StackPanel x:Name="SecCharacter" Style="{StaticResource Page}">
                    <TextBlock Style="{StaticResource H1}" Text="Персонаж"/>
                    <TextBlock Style="{StaticResource PageDesc}" Text="Кто живёт в чёлке"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SSegBox}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="ch" Content="Клоди" x:Name="ChPixel" Click="OnCharacter" Tag="pixel"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="ch" Content="Глаза" x:Name="ChEyes" Click="OnCharacter" Tag="eyes"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="ch" Content="Никого" x:Name="ChNone" Click="OnCharacter" Tag="none"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Кто в чёлке"/>
                                    <TextBlock Style="{StaticResource Info}" ToolTip="Клоди пляшет под музыку, думает вместе с ИИ, радуется готовому и засыпает, когда тебя нет."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Sep}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SSegBox}">
                                    <StackPanel x:Name="SnowModes" Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="snow" Content="Зимой" Click="OnSnowMode" Tag="auto"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="snow" Content="Всегда" Click="OnSnowMode" Tag="on"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="snow" Content="Выкл" Click="OnSnowMode" Tag="off"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Снег из-под чёлки"/>
                                        <TextBlock Style="{StaticResource Info}" ToolTip="«Зимой» — с 1 декабря по 14 января, а в другие дни — когда за окном идёт снег (по прогнозу)."/>
                                    </StackPanel>
                                    <TextBlock x:Name="SnowWhy" Style="{StaticResource RowNote}" MaxWidth="300"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="НАРЯД"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Margin="16,14,16,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Наряд Клоди"/>
                                <TextBlock Style="{StaticResource Info}" ToolTip="«По погоде» — сам одевается по погоде за окном: шапка и шарф, берет, ушанка, дождевик, панама, кепка. Или выбери наряд насовсем."/>
                            </StackPanel>
                            <Border Style="{StaticResource SSegBox}" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                <WrapPanel x:Name="Outfits">
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="По погоде" Click="OnOutfit" Tag="auto"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Без наряда" Click="OnOutfit" Tag="None"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Ковбой" Click="OnOutfit" Tag="Cowboy"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Корона" Click="OnOutfit" Tag="Crown"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Волшебник" Click="OnOutfit" Tag="Wizard"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Пират" Click="OnOutfit" Tag="Pirate"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Повар" Click="OnOutfit" Tag="Chef"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Праздник" Click="OnOutfit" Tag="Party"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Викинг" Click="OnOutfit" Tag="Viking"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Детектив" Click="OnOutfit" Tag="Detective"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Ниндзя" Click="OnOutfit" Tag="Ninja"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Венок" Click="OnOutfit" Tag="Flowers"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Выпускник" Click="OnOutfit" Tag="Graduate"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Ушанка" Click="OnOutfit" Tag="Frost"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Берет" Click="OnOutfit" Tag="Autumn"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Дождевик" Click="OnOutfit" Tag="Storm"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Панама" Click="OnOutfit" Tag="Heat"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Шапка и шарф" Click="OnOutfit" Tag="Winter"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Кепка" Click="OnOutfit" Tag="Sunny"/>
                                    <RadioButton Style="{StaticResource SSegment}" GroupName="outfit" Content="Очки" Click="OnOutfit" Tag="Summer"/>
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ ЧЁЛКА ============ -->
                <StackPanel x:Name="SecNotch" Style="{StaticResource Page}">
                    <TextBlock Style="{StaticResource H1}" Text="Чёлка"/>
                    <TextBlock Style="{StaticResource PageDesc}" Text="Вкладки и свёрнутый вид"/>

                    <StackPanel Orientation="Horizontal" Margin="12,0,0,8">
                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0" Text="ВКЛАДКИ"/>
                        <TextBlock Style="{StaticResource Info}" ToolTip="Переключатель — вкладка видна в чёлке, стрелки — порядок. «Главную» спрятать нельзя."/>
                    </StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="TabsList" Margin="0,4"/>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="СВЁРНУТАЯ ЧЁЛКА"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="ShowClock" Click="OnMusicToggle"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Часы"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Когда больше ничего не происходит"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource SepSub}"/>
                            <DockPanel x:Name="RowClockSeconds" Style="{StaticResource SubRow}">
                                <CheckBox DockPanel.Dock="Right" x:Name="ClockSeconds" Click="OnMusicToggle"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Секунды"/>
                                    <TextBlock Style="{StaticResource RowNote}" x:Name="SecondsHint" Text="21:05:33 вместо 21:05"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Sep}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="Clock24" Click="OnToggle"/>
                                <TextBlock Style="{StaticResource RowTitle}" Text="24-часовой формат"/>
                            </DockPanel>
                            <Border Style="{StaticResource Sep}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="Media" Click="OnMusicToggle"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Музыка в свёрнутой"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Обложка и полоски, пока играет"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ МУЗЫКА ============ -->
                <StackPanel x:Name="SecMusic" Style="{StaticResource Page}">
                    <TextBlock Style="{StaticResource H1}" Text="Музыка"/>
                    <TextBlock Style="{StaticResource PageDesc}" Text="Пилюля, плеер и текст песен"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SSegBox}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="pill" x:Name="PillBars" Content="Обычная" Tag="bars" Click="OnPill"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="pill" x:Name="PillTitle" Content="С названием" Tag="title" Click="OnPill"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="pill" x:Name="PillMini" Content="Мини-плеер" Tag="mini" Click="OnPill"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="pill" x:Name="PillLyrics" Content="С текстом" Tag="lyrics" Click="OnPill"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Пилюля"/>
                                    <TextBlock Style="{StaticResource Info}" ToolTip="«Обычная» — обложка и полоски ритма. «С названием» — трек и полоса времени. «Мини-плеер» — обложка, полоса и кнопки; открывается щелчком. «С текстом» — строка песни, которая звучит."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Sep}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SSegBox}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="hp" x:Name="HpMirror" Content="Зеркало" Tag="mirror" Click="OnHomePlayer"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="hp" x:Name="HpFill" Content="Заливка" Tag="fill" Click="OnHomePlayer"/>
                                        <RadioButton Style="{StaticResource SSegment}" GroupName="hp" x:Name="HpCompact" Content="Компактный" Tag="compact" Click="OnHomePlayer"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Плеер на Главной"/>
                                    <TextBlock Style="{StaticResource Info}" ToolTip="«Зеркало» — обложка по центру, вокруг её размытое свечение. «Заливка» — весь плеер в цветах обложки. «Компактный» — обложка слева, без свечения."/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="ТЕКСТ ПЕСНИ"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="Lyrics" Click="OnMusicToggle"/>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Текст песни"/>
                                        <TextBlock Style="{StaticResource Info}" ToolTip="Строки в такт музыке — в плеере и в пилюле «С текстом». Текст берётся из открытой базы LRCLIB (lrclib.net) только для песни, которая играет."/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Строки в такт музыке"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource SepSub}"/>
                            <DockPanel x:Name="RowLyricsHome" Style="{StaticResource SubRow}">
                                <CheckBox DockPanel.Dock="Right" x:Name="LyricsHome" Click="OnMusicToggle"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="На Главной"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Справа от обложки"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- место для блоков других сервисов (например, Spotify) -->
                    <StackPanel x:Name="MusicExtras">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="SPOTIFY"/>
                        <Border Style="{StaticResource Card}">
                            <v:SpotifyLinkPanel Margin="16,12"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ============ УВЕДОМЛЕНИЯ ============ -->
                <StackPanel x:Name="SecModules" Style="{StaticResource Page}">
                    <TextBlock Style="{StaticResource H1}" Text="Уведомления"/>
                    <TextBlock Style="{StaticResource PageDesc}" Text="Что всплывает в чёлке"/>

                    <TextBlock Style="{StaticResource SectionLabel}" Margin="12,0,0,8" Text="СИСТЕМНЫЕ СОБЫТИЯ"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="Volume" Click="OnToggle"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Volume" Width="15" Height="15"/></Border>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Громкость"/>
                            </DockPanel>
                            <Border Style="{StaticResource SepIcon}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="Layout" Click="OnToggle"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Keyboard" Width="15" Height="15"/></Border>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Смена раскладки"/>
                            </DockPanel>
                            <Border Style="{StaticResource SepIcon}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="Caps" Click="OnToggle"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Caps" Width="15" Height="15"/></Border>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Caps Lock"/>
                            </DockPanel>
                            <Border Style="{StaticResource SepIcon}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="Battery" Click="OnToggle"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Battery" Width="15" Height="15"/></Border>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Зарядка и низкий заряд"/>
                            </DockPanel>
                            <Border Style="{StaticResource SepIcon}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="Vpn" Click="OnToggle"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Shield" Width="15" Height="15"/></Border>
                                <TextBlock Style="{StaticResource RowTitle}" Text="VPN и страна"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

