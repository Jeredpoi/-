                            </DockPanel>
                            <Border Style="{StaticResource SepIcon}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="SaveShots" Click="OnSaveShots"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Folder" Width="15" Height="15"/></Border>
