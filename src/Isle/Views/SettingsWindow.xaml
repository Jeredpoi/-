                                    </StackPanel>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Чёрные квадраты — выключи"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="12,20,0,8">
