                                    <TextBlock Style="{StaticResource RowNote}" Text="Расставит ИИ, слова не меняются"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Sep}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="VoicePaste" Click="OnToggle"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Вставлять сразу"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Туда, где курсор; в буфере тоже"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
