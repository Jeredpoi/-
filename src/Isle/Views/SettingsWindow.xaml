                                    <TextBlock Style="{StaticResource RowTitle}" Text="Порт"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Порт 4455, пароль из OBS → WebSocket"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Sep}"/>
