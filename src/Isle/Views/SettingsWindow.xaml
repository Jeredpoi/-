                    </StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBox DockPanel.Dock="Right" x:Name="ObsPort" Width="120" Tag="4455" LostFocus="OnObsFields"/>
