                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Timer" Width="15" Height="15"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Проверять сам"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="При запуске и раз в полчаса"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource SepIcon}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SFlat}" Content="Открыть" Click="OnReleases"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="External" Width="15" Height="15"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Все версии"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Изменения и установщики на GitHub"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="ДАННЫЕ И ЖУРНАЛ"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SFlat}" Content="Открыть" Click="OnDataDir"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Folder" Width="15" Height="15"/></Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Папка данных"/>
                                    <TextBlock Style="{StaticResource RowNote}" x:Name="DataDirText" MaxWidth="380"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource SepIcon}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <CheckBox DockPanel.Dock="Right" x:Name="DebugLog" Click="OnToggle"/>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Code" Width="15" Height="15"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Журнал для отладки"/>
                                        <TextBlock Style="{StaticResource Info}" ToolTip="Пишет всё: кадры анимаций, зависания, процессор и память, мониторы, ошибки. Без буфера обмена, клавиш и паролей. Файл — %AppData%\Isle\isle.log"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Без буфера, клавиш и паролей"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="ЗНАКОМСТВО"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel Style="{StaticResource Row}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SFlat}" Content="Открыть снова" Click="OnShowWelcome"/>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Tile}"><h:Icon Kind="Home" Width="15" Height="15"/></Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Знакомство с Isle"/>
                                <TextBlock Style="{StaticResource RowNote}" Text="То, что было при первом запуске"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
