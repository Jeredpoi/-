                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="Журнал загрузок"/>
                                    <TextBlock Style="{StaticResource RowNote}" Text="Что Isle получил от Steam"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ БУФЕР ОБМЕНА ============ -->
