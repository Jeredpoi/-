                                    </StackPanel>
                                    <TextBlock x:Name="SteamExactStatus" Style="{StaticResource RowNote}" MaxWidth="320" Text="Isle один раз перезапустит Steam"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource SepIcon}"/>
                            <DockPanel Style="{StaticResource Row}">
