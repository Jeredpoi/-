<UserControl x:Class="Isle.Views.SpotifyLinkPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Isle.Helpers">
    <!-- Необязательная привязка Spotify: текст песен по слогам из Spicy Lyrics и управление Spotify (Web API). Блок самодостаточный —
         вставляется на страницу «Музыка» в настройках как есть. -->
    <UserControl.Resources>
        <!-- текст инструкции выделяется и копируется -->
        <Style x:Key="PSelect" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- заголовок + подсказка с шагами настройки -->
        <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource PTitle}" Text="Spotify: управление музыкой"/>
        </DockPanel>

        <TextBlock Style="{StaticResource PNote}" Margin="0,3,0,0" Text="Необязательно. Без привязки кнопки управляют плеером через Windows. С привязкой (нужен Premium) работают повтор, перемешивание и громкость самого Spotify."/>

        <!-- «Как привязать»: раскрывается по клику (раньше — подсказка, которая пропадала от клика и не давала копировать) -->
        <Border Background="Transparent" Cursor="Hand" Margin="0,8,0,0" MouseLeftButtonUp="OnHowToggle" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <h:Icon Data="M9 6l6 6-6 6" Width="12" Height="12" StrokeWidth="2" Foreground="{DynamicResource Muted}" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                    <h:Icon.RenderTransform><RotateTransform x:Name="HowRot"/></h:Icon.RenderTransform>
                </h:Icon>
                <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" Text="Как привязать"/>
            </StackPanel>
        </Border>
        <StackPanel x:Name="HowBody" Margin="18,6,0,0" Visibility="Collapsed">
            <TextBox Style="{StaticResource PSelect}" Text="1. Открой developer.spotify.com/dashboard → Create app (название любое, API — Web API).&#10;2. В Redirect URIs добавь http://127.0.0.1:47533/spotify-callback и сохрани.&#10;3. Скопируй Client ID в поле ниже и нажми «Привязать Spotify» — откроется вход в браузере."/>
            <Button Style="{StaticResource Ghost}" Padding="0,4" FontSize="11" HorizontalAlignment="Left" Margin="0,4,0,0" Content="Скопировать адрес developer.spotify.com/dashboard"
                    Foreground="{DynamicResource Muted}" Click="OnCopyDashboard"/>
        </StackPanel>

        <!-- статус -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Muted}"/>
            <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" Text="Не привязан"/>
        </StackPanel>

        <!-- привязка старая: токен без права управлять воспроизведением — кнопки работают через Windows -->
        <TextBlock x:Name="ScopeHint" Style="{StaticResource PNote}" Margin="16,4,0,0" Visibility="Collapsed"
                   Text="Перепривяжи, чтобы управлять Spotify"/>

        <!-- Client ID -->
        <TextBox x:Name="ClientIdBox" Margin="0,10,0,0" Tag="Client ID приложения Spotify" LostFocus="OnClientIdLostFocus"/>

        <!-- Redirect URI: его надо вставить в настройки приложения на developer.spotify.com -->
        <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="6,2" FontSize="11" Content="Скопировать" Click="OnCopyRedirect"
                    Foreground="{DynamicResource Muted}" ToolTip="Скопировать Redirect URI"/>
            <TextBlock Style="{StaticResource PNote}" FontSize="11" VerticalAlignment="Center">
                <Run Text="Redirect URI:"/>
                <Run x:Name="RedirectRun" Text="http://127.0.0.1:47533/spotify-callback"/>
            </TextBlock>
        </DockPanel>

        <!-- кнопки -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="LinkBtn" Style="{StaticResource Primary}" Content="Привязать Spotify" Click="OnLink"/>
            <Button x:Name="UnlinkBtn" Style="{StaticResource Ghost}" Margin="8,0,0,0" Padding="10,6" Content="Отвязать" Click="OnUnlink"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Visibility="Collapsed"/>

    </StackPanel>
</UserControl>
