<UserControl x:Class="Isle.Views.TextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Isle.Helpers">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="2,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Ghost}" Click="OnPaste" ToolTip="Вставить из буфера"><h:Icon Kind="Clipboard" Width="14" Height="14"/></Button>
                    <Button Style="{StaticResource Ghost}" Click="OnCopy" ToolTip="Скопировать результат"><h:Icon Kind="Copy" Width="14" Height="14"/></Button>
                    <Button Style="{StaticResource Ghost}" Click="OnClear" ToolTip="Очистить"><h:Icon Kind="Trash" Width="14" Height="14"/></Button>
                </StackPanel>
                <TextBlock x:Name="Stats" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="Input" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" Tag="Вставь или напиши текст, затем нажми инструмент справа" TextChanged="OnChanged"/>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="ИНСТРУМЕНТЫ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,0,0,8"/>
            <TextBlock x:Name="Error" DockPanel.Dock="Bottom" FontSize="11" Foreground="{StaticResource Red}" TextWrapping="Wrap" Margin="2,6,0,0"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <UniformGrid x:Name="ToolGrid" Columns="2" VerticalAlignment="Top"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
