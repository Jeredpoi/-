<UserControl x:Class="Isle.Views.WeatherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:Isle.Helpers">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border CornerRadius="18" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="0">
            <Grid ClipToBounds="True">
                <Border x:Name="HeroBackground" CornerRadius="17" Background="#243246"/>
                <Canvas x:Name="WeatherFx" IsHitTestVisible="False" ClipToBounds="True" SizeChanged="OnWeatherFxSizeChanged"/>
                <DockPanel Margin="16">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="OnRefresh" ToolTip="Обновить">
                        <h:Icon Kind="Restart" Width="13" Height="13" Foreground="#A1A1AB"/>
                    </Button>
                    <TextBlock x:Name="City" Text="—" FontSize="12" Foreground="#A1A1AB" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,0">
                    <h:WeatherGlyph x:Name="GlyphAnim" Width="54" Height="54" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Temp" Text="—" FontSize="50" FontWeight="SemiBold" Margin="10,0,0,0">
                        <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/></TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="Desc" FontSize="14" FontWeight="Medium">
                    <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock DockPanel.Dock="Top" x:Name="Snow" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,3,0,0"/>
                <TextBlock DockPanel.Dock="Top" x:Name="Feels" FontSize="11" Foreground="#A1A1AB" Margin="0,2,0,0"/>
                <TextBlock DockPanel.Dock="Bottom" x:Name="Sun" FontSize="11" Foreground="#A1A1AB" Margin="0,8,0,0"/>
                <UniformGrid DockPanel.Dock="Bottom" Columns="3" VerticalAlignment="Bottom">
                    <Border CornerRadius="10" Background="#17171A" Padding="8,6" Margin="0,0,4,0">
                        <StackPanel><TextBlock Text="ветер" FontSize="10" Foreground="#8B8B95"/><TextBlock x:Name="Wind" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                    <Border CornerRadius="10" Background="#17171A" Padding="8,6" Margin="2,0">
                        <StackPanel><TextBlock Text="влажность" FontSize="10" Foreground="#8B8B95"/><TextBlock x:Name="Hum" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                    <Border CornerRadius="10" Background="#17171A" Padding="8,6" Margin="4,0,0,0">
                        <StackPanel><TextBlock Text="осадки" FontSize="10" Foreground="#8B8B95"/><TextBlock x:Name="Prec" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                </UniformGrid>
                <Grid/>
                </DockPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Style="{StaticResource CardBox}" Padding="8,10">
                <ItemsControl x:Name="Hours">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Time}" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" Margin="0,4"/>
                                <TextBlock Text="{Binding Temp}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Border Style="{StaticResource CardBox}" Margin="0,10,0,0" Padding="14,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="Данные MET Norway" Style="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Right"/>
                    <ItemsControl x:Name="Days">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="13"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MinText}" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Right" Margin="0,0,8,0"/>
                                    <Grid Grid.Column="3" VerticalAlignment="Center" Height="4" Width="160" HorizontalAlignment="Left">
                                        <Border CornerRadius="2" Background="{StaticResource Track}"/>
                                        <Canvas>
                                            <Border Canvas.Left="{Binding BarLeft}" Width="{Binding BarWidth}" Height="4" CornerRadius="2">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#55555F" Offset="0"/>
                                                        <GradientStop Color="#ECECF1" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                    <TextBlock Grid.Column="4" Text="{Binding MaxText}" FontSize="12" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="5" Text="{Binding PrecipText}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
